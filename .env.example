# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.

# --- Groq (COMPLEX lane, primary — final answer generation) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- NVIDIA NIM (SIMPLE lane, primary — rewrite/route/grade/hyde) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=your_nvidia_model_here

# --- Local LM Studio (final fallback for both lanes) ---
# Only usable when running this project on a machine with LM Studio installed
# and running locally — not available on a hosted/deployed server.
LM_STUDIO_ENABLED=true
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen

# --- LLM manager retry/failover behavior ---
LLM_MAX_RETRIES_PER_PROVIDER=your_value_here
LLM_RETRY_BACKOFF_SECONDS=your_value_here
LLM_LOG_TO_FILE=true
LLM_LOG_FILE_PATH=llm_manager.log
